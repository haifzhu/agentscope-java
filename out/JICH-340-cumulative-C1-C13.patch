+import { describe, expect, it } from "vitest";
+import type { Issue } from "@/api/collaboration";
+import type { OrchestrationRun } from "@/api/orchestration";
+import { hasFailedAttempt, rankedAttention, runAlertsOf, runHealthOf } from "./workbenchModel";
+
+const run = (id: string, rest: Partial<OrchestrationRun> = {}): OrchestrationRun => ({
+  id, tenant: "t", namespace: "n", rootIssueId: "issue-1", mode: "direct", triggerType: "issue",
+  state: "succeeded", version: 1, createdAt: "2026-09-24T08:00:00Z", ...rest,
+});
+
+const issue = (id: string, status: string, rest: Partial<Issue> = {}): Issue => ({
+  id, tenant: "t", namespace: "n", title: `issue ${id}`, status, priority: "normal", kind: "user_work",
+  visibility: "work_hub", completionPolicy: "review", creator: { type: "human", ref: "alice" },
+  version: 1, createdAt: "2026-09-24T08:00:00Z", updatedAt: "2026-09-24T09:00:00Z", ...rest,
+});
+
+describe("workbench run health (PRD 5.3.1)", () => {
+  it("counts running and failed runs and averages only completed durations", () => {
+    const health = runHealthOf([
+      run("a", { state: "running", startedAt: "2026-09-24T08:00:00Z" }),
+      run("b", { state: "failed", startedAt: "2026-09-24T08:00:00Z", completedAt: "2026-09-24T08:00:30Z", usage: { totalTokens: 100 } }),
+      run("c", { state: "succeeded", startedAt: "2026-09-24T08:00:00Z", completedAt: "2026-09-24T08:01:30Z", usage: { totalTokens: 50 } }),
+    ]);
+    expect(health.running).toBe(1);
+    expect(health.failed).toBe(1);
+    expect(health.averageDurationMs).toBe(60000);
+    expect(health.totalTokens).toBe(150);
+  });
+  it("reports null metrics instead of fabricating zero when there is no data", () => {
+    const health = runHealthOf([run("a", { state: "running", startedAt: "2026-09-24T08:00:00Z" })]);
+    expect(health.averageDurationMs).toBeNull();
+    expect(health.totalTokens).toBeNull();
+  });
+});
+
+describe("workbench anomaly alerts (PRD 5.3.1)", () => {
+  const now = new Date("2026-09-24T09:00:00Z").getTime();
+  it("surfaces failed runs and runs stuck beyond the threshold", () => {
+    const alerts = runAlertsOf([
+      run("failed-run", { state: "failed", completedAt: "2026-09-24T08:55:00Z", failureMessage: "boom" }),
+      run("stuck-run", { state: "running", startedAt: "2026-09-24T08:00:00Z" }),
+      run("fresh-run", { state: "running", startedAt: "2026-09-24T08:58:00Z" }),
+    ], now);
+    expect(alerts.map(alert => alert.id)).toEqual(["failed-run:failed", "stuck-run:stuck"]);
+    expect(alerts[0].detail).toBe("boom");
+  });
+  it("returns no alert for a run that finished successfully or ran briefly", () => {
+    expect(runAlertsOf([run("ok", { completedAt: "2026-09-24T08:30:00Z" })], now)).toEqual([]);
+  });
+});
+
+describe("workbench attention ranking (PRD 5.3.1)", () => {
+  it("orders blocked before review before pending and hides finished work", () => {
+    const ranked = rankedAttention([
+      issue("pending", "todo"),
+      issue("done-issue", "done"),
+      issue("blocked", "blocked"),
+      issue("review", "in_review"),
+      issue("archived", "open", { archivedAt: "2026-09-24T08:00:00Z" }),
+    ]);
+    expect(ranked.map(entry => entry.id)).toEqual(["blocked", "review", "pending"]);
+    expect(ranked.map(entry => entry.label)).toEqual(["被阻塞", "待验收", "待处理"]);
+  });
+  it("limits the list to the requested size", () => {
+    const items = Array.from({ length: 10 }, (_, index) => issue(`i${index}`, "todo"));
+    expect(rankedAttention(items, 4)).toHaveLength(4);
+  });
+});
+
+describe("failed node highlight (PRD 5.5.3)", () => {
+  it("detects failed attempts in a collapsed tree", () => {
+    expect(hasFailedAttempt([{ id: "a", state: "failed" } as never])).toBe(true);
+    expect(hasFailedAttempt([{ id: "a", state: "running", failureCode: "x" } as never])).toBe(true);
+    expect(hasFailedAttempt([{ id: "a", state: "succeeded", failureCode: null } as never])).toBe(false);
+  });
+});
diff --git a/agentscope-service/frontend/src/features/work/workbenchModel.ts b/agentscope-service/frontend/src/features/work/workbenchModel.ts
new file mode 100644
index 00000000..38aa9372
--- /dev/null
+++ b/agentscope-service/frontend/src/features/work/workbenchModel.ts
@@ -0,0 +1,143 @@
+/*
+ * Copyright 2024-2026 the original author or authors.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+import type { AgentTask, Issue } from "@/api/collaboration";
+import type { ExecutionAttempt, OrchestrationRun } from "@/api/orchestration";
+
+const TERMINAL_RUN_STATES = ["succeeded", "partial_succeeded", "failed", "cancelled"];
+
+export function isTerminalRun(state: string): boolean {
+  return TERMINAL_RUN_STATES.includes(state);
+}
+
+/** 运行健康度（PRD 5.3.1）：进行中、失败、平均耗时、Token。 */
+export interface RunHealth {
+  running: number;
+  failed: number;
+  averageDurationMs: number | null;
+  totalTokens: number | null;
+}
+
+function usageTokens(usage: unknown): number | null {
+  if (!usage || typeof usage !== "object") return null;
+  const value = (usage as Record<string, unknown>).totalTokens;
+  return typeof value === "number" ? value : null;
+}
+
+function durationOf(run: OrchestrationRun): number | null {
+  if (!run.startedAt || !run.completedAt) return null;
+  const started = new Date(run.startedAt).getTime();
+  const completed = new Date(run.completedAt).getTime();
+  return Number.isFinite(started) && Number.isFinite(completed) && completed >= started ? completed - started : null;
+}
+
+export function runHealthOf(runs: OrchestrationRun[]): RunHealth {
+  const running = runs.filter(run => !isTerminalRun(run.state)).length;
+  const failed = runs.filter(run => run.state === "failed").length;
+  const durations = runs.map(durationOf).filter((value): value is number => value != null);
+  const tokens = runs.map(run => usageTokens(run.usage)).filter((value): value is number => value != null);
+  return {
+    running,
+    failed,
+    averageDurationMs: durations.length ? Math.round(durations.reduce((sum, value) => sum + value, 0) / durations.length) : null,
+    totalTokens: tokens.length ? tokens.reduce((sum, value) => sum + value, 0) : null,
+  };
+}
+
+/** 异常提醒（PRD 5.3.1）：最近失败的执行、卡住的执行、失败的投递。 */
+export interface RunAlert {
+  id: string;
+  kind: "failed" | "stuck";
+  title: string;
+  detail: string;
+  at: string;
+  href: string;
+  issueId?: string;
+}
+
+const STUCK_AFTER_MS = 15 * 60 * 1000;
+
+export function runAlertsOf(runs: OrchestrationRun[], now: number): RunAlert[] {
+  const alerts: RunAlert[] = [];
+  for (const run of runs) {
+    if (run.state === "failed") {
+      alerts.push({
+        id: `${run.id}:failed`,
+        kind: "failed",
+        title: "执行失败",
+        detail: run.failureMessage || run.failureCode || `执行 ${run.id.slice(0, 8)} 失败`,
+        at: run.completedAt || run.createdAt,
+        href: `/work/executions/${run.id}`,
+        issueId: run.rootIssueId,
+      });
+      continue;
+    }
+    if (!isTerminalRun(run.state) && run.startedAt) {
+      const started = new Date(run.startedAt).getTime();
+      if (Number.isFinite(started) && now - started > STUCK_AFTER_MS) {
+        alerts.push({
+          id: `${run.id}:stuck`,
+          kind: "stuck",
+          title: "执行长时间无进展",
+          detail: run.waitReason || `已等待 ${Math.round((now - started) / 60000)} 分钟`,
+          at: run.startedAt,
+          href: `/work/executions/${run.id}`,
+          issueId: run.rootIssueId,
+        });
+      }
+    }
+  }
+  return alerts.sort((left, right) => new Date(right.at).getTime() - new Date(left.at).getTime()).slice(0, 8);
+}
+
+/** 「需要我处理」（PRD 5.3.1）：按紧急度排序的待处理事项。 */
+export interface AttentionEntry {
+  id: string;
+  label: string;
+  title: string;
+  at: string;
+  href: string;
+}
+
+const ATTENTION_WEIGHT: Record<string, number> = { blocked: 0, in_review: 1, todo: 2, open: 2, in_progress: 3, backlog: 4 };
+
+export function rankedAttention(issues: Issue[], limit = 6): AttentionEntry[] {
+  return issues
+    .filter(issue => !issue.archivedAt && !["done", "cancelled"].includes(issue.status))
+    .map(issue => ({
+      id: issue.id,
+      label: issue.status === "blocked" ? "被阻塞" : issue.status === "in_review" ? "待验收" : "待处理",
+      title: issue.title,
+      at: issue.updatedAt,
+      href: `/work/issues/${issue.id}`,
+    }))
+    .sort((left, right) => {
+      const leftRank = ATTENTION_WEIGHT[issues.find(issue => issue.id === left.id)?.status || ""] ?? 5;
+      const rightRank = ATTENTION_WEIGHT[issues.find(issue => issue.id === right.id)?.status || ""] ?? 5;
+      if (leftRank !== rightRank) return leftRank - rightRank;
+      return new Date(right.at).getTime() - new Date(left.at).getTime();
+    })
+    .slice(0, limit);
+}
+
+/** 失败节点在折叠态即高亮的判定（PRD 5.5.3），供工作台与执行记录复用。 */
+export function hasFailedAttempt(attempts: ExecutionAttempt[]): boolean {
+  return attempts.some(attempt => attempt.state === "failed" || attempt.failureCode != null);
+}
+
+export function failedTasksOf(tasks: AgentTask[]): AgentTask[] {
+  return tasks.filter(task => task.status === "failed" || task.errorCode != null);
+}
